#X obj 550 90 * 8;
#X obj 550 110 + 0.5;
#X obj 550 130 i;
#X obj 550 150 - 4;
#X obj 550 170 clip -4 4;
#X obj 550 190 route -4 -3 -2 -1 0 1 2 3 4;
