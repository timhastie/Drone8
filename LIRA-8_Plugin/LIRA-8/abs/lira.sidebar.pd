# Delay 1 Division Display:
#X obj 380 30 r \$1-s-f-a;
#X obj 380 50 r \$1-s-time-1;
#X obj 380 70 / 127;
#X obj 380 90 * 8;
#X obj 380 110 + 0.5;
#X obj 380 130 i;
#X obj 380 150 - 4;
#X obj 380 170 clip -4 4;
#X obj 380 190 route -4 -3 -2 -1 0 1 2 3 4;
#X msg 440 210 set 1/16;
#X msg 440 230 set 1/8;
#X msg 440 250 set 1/4;
#X msg 440 270 set 1/2;
#X msg 440 290 set 1;
#X msg 440 310 set 2;
#X msg 440 330 set 4;
#X msg 440 350 set 8;
#X msg 440 370 set 16;
#X obj 440 420 s lira8_div1_sym;

# Delay 2 Division Display:
#X obj 550 30 r \$1-s-f-b;
#X obj 550 50 r \$1-s-time-2;
