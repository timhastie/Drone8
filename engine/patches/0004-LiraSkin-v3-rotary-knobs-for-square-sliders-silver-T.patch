 }
@@ -361,7 +367,8 @@ void GuiSliderHorizontal::mouseDrag(const MouseEvent& e)
     }
     else
     {
-        const float val = static_cast<float>(e.x - e.getMouseDownX()) / static_cast<float>(getWidth() - 7) * (m_shift ? 0.01f : 1.0f);
+        const float span = LiraSkin::isKnob(getWidth(), getHeight()) ? 200.f : static_cast<float>(getWidth() - 7);
+        const float val = static_cast<float>(e.x - e.getMouseDownX()) / span * (m_shift ? 0.01f : 1.0f);
         if(gui.isLogScale())
         {
             setValueOriginal(exp((m_temp + val) * log(max / min)) * min);
@@ -386,6 +393,12 @@ void GuiSliderHorizontal::mouseUp(const MouseEvent& e)
 void GuiSliderVertical::paint(Graphics& g)
 {
     const float val = gui.isLogScale() ? log(getValueOriginal() / min) / log(max / min) : getValueScaled();
+    if(LiraSkin::isKnob(getWidth(), getHeight()))
+    {
+        if(getWidth() >= 52) LiraSkin::drawTuneDial(g, getLocalBounds().toFloat(), val);
+        else                 LiraSkin::drawKnob(g, getLocalBounds().toFloat(), val);
+    }
+    else
     LiraSkin::drawVFader(g, getLocalBounds().toFloat(), val,
                          LiraSkin::pdc(gui.getBackgroundColor()), LiraSkin::pdc(gui.getForegroundColor()));
 }
@@ -437,7 +450,8 @@ void GuiSliderVertical::mouseDrag(const MouseEvent& e)
     }
     else
     {
-        const float val = static_cast<float>(e.getMouseDownY() - e.y) / static_cast<float>(getHeight() - 7) * (m_shift ? 0.01f : 1.0f);
+        const float span = LiraSkin::isKnob(getWidth(), getHeight()) ? 200.f : static_cast<float>(getHeight() - 7);
+        const float val = static_cast<float>(e.getMouseDownY() - e.y) / span * (m_shift ? 0.01f : 1.0f);
         if(gui.isLogScale())
         {
             setValueOriginal(exp((m_temp + val) * log(max / min)) * min);
diff --git a/Source/PluginLookAndFeel.cpp b/Source/PluginLookAndFeel.cpp
