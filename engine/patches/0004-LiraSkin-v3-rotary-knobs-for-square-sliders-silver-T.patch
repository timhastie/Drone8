+++ b/Source/PluginLookAndFeel.cpp
@@ -87,11 +87,11 @@ Font CamoLookAndFeel::getDefaultFont()
 
 Font CamoLookAndFeel::getFont(const std::string& name)
 {
-    if(name == "DejaVu Sans Mono")
-    {
-        return getDefaultFont();
-    }
-    return Font(String(name), Font::plain, 12.f);
+    // LIRA fork: hardware-style geometric face for all labels (falls back to
+    // the platform default sans when Futura is unavailable).
+    juce::ignoreUnused(name);
+    static Font lira = Font("Futura", 12.f, Font::plain);
+    return lira;
 }
 
