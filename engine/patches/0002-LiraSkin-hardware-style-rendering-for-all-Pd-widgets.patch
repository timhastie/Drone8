@@ -0,0 +1,291 @@
+/*
+ // LIRA fork: hardware-style widget rendering (Lyra-8 front / 303-style sequencer).
+ // Style is selected from each widget's declared Pd colors + geometry, so the
+ // patch stays the single source of truth for layout and behavior.
+*/
+
+#pragma once
+
+#include "PluginEditorInteraction.h"
+
+namespace LiraSkin
+{
+    inline juce::Colour pdc(unsigned int c) { return juce::Colour(static_cast<juce::uint32>(c)); }
+    inline bool isDark(juce::Colour c) { return c.getPerceivedBrightness() < 0.55f; }
+
+    inline void vgrad(juce::Graphics& g, juce::Rectangle<float> r, juce::Colour top, juce::Colour bot)
+    {
+        g.setGradientFill(juce::ColourGradient(top, r.getX(), r.getY(), bot, r.getX(), r.getBottom(), false));
+    }
+    inline void hgrad(juce::Graphics& g, juce::Rectangle<float> r, juce::Colour left, juce::Colour right)
+    {
+        g.setGradientFill(juce::ColourGradient(left, r.getX(), r.getY(), right, r.getRight(), r.getY(), false));
+    }
+
+    // ------------------------------------------------------------------ faders
+    inline void drawVFader(juce::Graphics& g, juce::Rectangle<float> b, float pos, juce::Colour bg, juce::Colour /*fg*/)
+    {
+        const bool front = !isDark(bg); // white-bg sliders live on the mint front panel
+        const float w = b.getWidth(), h = b.getHeight();
+        const float capH = juce::jlimit(9.f, 20.f, h * (h < 70.f ? 0.24f : 0.13f));
+        // groove
+        const float gw = juce::jlimit(3.f, 9.f, w * 0.28f);
+        juce::Rectangle<float> groove((w - gw) * 0.5f, capH * 0.5f, gw, h - capH);
+        vgrad(g, groove, juce::Colour(0xff101010), juce::Colour(0xff2b2b2b));
+        g.fillRoundedRectangle(groove, gw * 0.5f);
+        g.setColour(juce::Colours::white.withAlpha(front ? 0.35f : 0.12f));
+        g.drawLine(groove.getX(), groove.getBottom() + 0.5f, groove.getRight(), groove.getBottom() + 0.5f, 1.f);
+        // cap
+        pos = juce::jlimit(0.f, 1.f, pos);
+        const float cy = (1.f - pos) * (h - capH - 2.f) + 1.f;
+        juce::Rectangle<float> cap(1.f, cy, w - 2.f, capH);
+        g.setColour(juce::Colours::black.withAlpha(0.35f));
+        g.fillRoundedRectangle(cap.translated(0.f, 1.5f).expanded(0.4f, 0.f), 2.f);
+        if(front) // black skirted cap, Lyra knob colors
+        {
+            vgrad(g, cap, juce::Colour(0xff4d4d4d), juce::Colour(0xff161616));
+            g.fillRoundedRectangle(cap, 2.f);
+            g.setColour(juce::Colours::white.withAlpha(0.16f));
+            for(int i = 1; i <= 2; ++i)
+            {
+                const float ry = cap.getY() + cap.getHeight() * (0.5f + 0.24f * i / 2.f);
+                g.drawLine(cap.getX() + 2.f, ry, cap.getRight() - 2.f, ry, 1.f);
+                const float ry2 = cap.getY() + cap.getHeight() * (0.5f - 0.24f * i / 2.f);
+                g.drawLine(cap.getX() + 2.f, ry2, cap.getRight() - 2.f, ry2, 1.f);
+            }
+            g.setColour(juce::Colours::white);
+            g.fillRect(cap.getX() + 1.5f, cap.getCentreY() - 1.f, cap.getWidth() - 3.f, 2.f);
+        }
+        else      // silver ridged cap on dark sections
+        {
+            vgrad(g, cap, juce::Colour(0xffe2e2e2), juce::Colour(0xff8f8f8f));
+            g.fillRoundedRectangle(cap, 2.f);
+            g.setColour(juce::Colours::black.withAlpha(0.28f));
+            for(int i = 1; i <= 2; ++i)
+            {
+                const float ry = cap.getY() + cap.getHeight() * (0.5f + 0.24f * i / 2.f);
+                g.drawLine(cap.getX() + 2.f, ry, cap.getRight() - 2.f, ry, 1.f);
+                const float ry2 = cap.getY() + cap.getHeight() * (0.5f - 0.24f * i / 2.f);
+                g.drawLine(cap.getX() + 2.f, ry2, cap.getRight() - 2.f, ry2, 1.f);
+            }
+            g.setColour(juce::Colour(0xff1a1a1a));
+            g.fillRect(cap.getX() + 1.5f, cap.getCentreY() - 1.f, cap.getWidth() - 3.f, 2.f);
+        }
+        g.setColour(juce::Colours::black.withAlpha(0.65f));
+        g.drawRoundedRectangle(cap, 2.f, 1.f);
+    }
+
+    inline void drawHFader(juce::Graphics& g, juce::Rectangle<float> b, float pos, juce::Colour bg, juce::Colour /*fg*/)
+    {
+        const bool front = !isDark(bg);
+        const float w = b.getWidth(), h = b.getHeight();
+        const float capW = juce::jlimit(9.f, 20.f, w * (w < 90.f ? 0.24f : 0.09f));
+        const float gh = juce::jlimit(3.f, 9.f, h * 0.28f);
+        juce::Rectangle<float> groove(capW * 0.5f, (h - gh) * 0.5f, w - capW, gh);
+        vgrad(g, groove, juce::Colour(0xff101010), juce::Colour(0xff2b2b2b));
+        g.fillRoundedRectangle(groove, gh * 0.5f);
+        g.setColour(juce::Colours::white.withAlpha(front ? 0.35f : 0.12f));
+        g.drawLine(groove.getX(), groove.getBottom() + 0.5f, groove.getRight(), groove.getBottom() + 0.5f, 1.f);
+        pos = juce::jlimit(0.f, 1.f, pos);
+        const float cx = pos * (w - capW - 2.f) + 1.f;
+        juce::Rectangle<float> cap(cx, 1.f, capW, h - 2.f);
+        g.setColour(juce::Colours::black.withAlpha(0.35f));
+        g.fillRoundedRectangle(cap.translated(0.f, 1.5f), 2.f);
+        if(front)
+        {
+            vgrad(g, cap, juce::Colour(0xff4d4d4d), juce::Colour(0xff161616));
+            g.fillRoundedRectangle(cap, 2.f);
+            g.setColour(juce::Colours::white.withAlpha(0.16f));
+        }
+        else
+        {
+            vgrad(g, cap, juce::Colour(0xffe2e2e2), juce::Colour(0xff8f8f8f));
+            g.fillRoundedRectangle(cap, 2.f);
+            g.setColour(juce::Colours::black.withAlpha(0.28f));
+        }
+        for(int i = 1; i <= 2; ++i)
+        {
+            const float rx = cap.getX() + cap.getWidth() * (0.5f + 0.24f * i / 2.f);
+            g.drawLine(rx, cap.getY() + 2.f, rx, cap.getBottom() - 2.f, 1.f);
+            const float rx2 = cap.getX() + cap.getWidth() * (0.5f - 0.24f * i / 2.f);
+            g.drawLine(rx2, cap.getY() + 2.f, rx2, cap.getBottom() - 2.f, 1.f);
+        }
+        g.setColour(front ? juce::Colours::white : juce::Colour(0xff1a1a1a));
+        g.fillRect(cap.getCentreX() - 1.f, cap.getY() + 1.5f, 2.f, cap.getHeight() - 3.f);
+        g.setColour(juce::Colours::black.withAlpha(0.65f));
+        g.drawRoundedRectangle(cap, 2.f, 1.f);
+    }
+
+    // ------------------------------------------------------------------ toggles
+    inline void drawLED(juce::Graphics& g, juce::Rectangle<float> b, bool on, juce::Colour accent)
+    {
+        auto d = b.reduced(juce::jmax(1.f, b.getWidth() * 0.12f));
+        g.setColour(juce::Colour(0xff141414));
+        g.fillEllipse(d);
+        if(on)
+        {
+            g.setColour(accent.withAlpha(0.35f));
+            g.fillEllipse(d.expanded(1.5f));
+            g.setColour(accent);
+            g.fillEllipse(d.reduced(1.f));
+            g.setColour(juce::Colours::white.withAlpha(0.55f));
+            g.fillEllipse(d.reduced(d.getWidth() * 0.32f).translated(-d.getWidth() * 0.08f, -d.getWidth() * 0.08f));
+        }
+        else
+        {
+            g.setColour(accent.withAlpha(0.22f));
+            g.fillEllipse(d.reduced(1.f));
+        }
+        g.setColour(juce::Colours::black.withAlpha(0.7f));
+        g.drawEllipse(d, 1.f);
+    }
+
+    inline void drawStepPad(juce::Graphics& g, juce::Rectangle<float> b, bool on, juce::Colour accent)
+    {
+        auto r = b.reduced(0.5f);
+        g.setColour(juce::Colours::black.withAlpha(0.5f));
+        g.fillRoundedRectangle(r.translated(0.f, 1.f), 3.f);
+        if(on)
+        {
+            g.setColour(accent.withAlpha(0.30f));
+            g.fillRoundedRectangle(r.expanded(1.f), 3.5f);
+            vgrad(g, r, accent.brighter(0.25f), accent.darker(0.35f));
+            g.fillRoundedRectangle(r, 3.f);
+            g.setColour(juce::Colours::white.withAlpha(0.30f));
+            g.fillRoundedRectangle(r.withHeight(r.getHeight() * 0.42f).reduced(1.5f, 1.5f), 2.f);
+        }
+        else
+        {
+            vgrad(g, r, juce::Colour(0xff2c2c2c), juce::Colour(0xff191919));
+            g.fillRoundedRectangle(r, 3.f);
+            g.setColour(juce::Colours::white.withAlpha(0.06f));
+            g.fillRoundedRectangle(r.withHeight(r.getHeight() * 0.42f).reduced(1.5f, 1.5f), 2.f);
+        }
+        g.setColour(juce::Colours::black.withAlpha(0.8f));
+        g.drawRoundedRectangle(r, 3.f, 1.f);
+    }
+
+    inline void drawRocker(juce::Graphics& g, juce::Rectangle<float> b, bool on)
+    {
+        auto r = b.reduced(0.5f);
+        // recessed dark plate
+        vgrad(g, r, juce::Colour(0xff1d1e1a), juce::Colour(0xff30322b));
+        g.fillRoundedRectangle(r, 3.f);
+        g.setColour(juce::Colours::black.withAlpha(0.7f));
+        g.drawRoundedRectangle(r, 3.f, 1.f);
+        // lever knob: top when on, bottom when off
+        const float kd = juce::jmin(r.getWidth(), r.getHeight() * 0.55f) - 3.f;
+        const float kx = r.getCentreX() - kd * 0.5f;
+        const float ky = on ? r.getY() + 1.5f : r.getBottom() - kd - 1.5f;
+        g.setColour(juce::Colours::black.withAlpha(0.5f));
+        g.fillEllipse(kx, ky + 1.f, kd, kd);
+        juce::Rectangle<float> knob(kx, ky, kd, kd);
+        vgrad(g, knob, on ? juce::Colour(0xfff2f2f2) : juce::Colour(0xffb5b5b5),
+                       on ? juce::Colour(0xff9d9d9d) : juce::Colour(0xff6f6f6f));
+        g.fillEllipse(knob);
+        g.setColour(juce::Colours::black.withAlpha(0.6f));
+        g.drawEllipse(knob, 1.f);
+    }
+
+    // ------------------------------------------------------------------ bang
+    inline void drawBang(juce::Graphics& g, juce::Rectangle<float> b, bool flash, juce::Colour bg, juce::Colour fg)
+    {
+        const float w = juce::jmin(b.getWidth(), b.getHeight());
+        juce::Rectangle<float> d(b.getX() + (b.getWidth() - w) * 0.5f, b.getY() + (b.getHeight() - w) * 0.5f, w, w);
+        d = d.reduced(1.f);
+        const bool ghost = isDark(bg) && isDark(fg); // invisible arrow-style bangs keep their painted label
+        if(ghost)
+        {
+            g.setColour(juce::Colours::white.withAlpha(flash ? 0.30f : 0.10f));
+            g.drawEllipse(d, 1.f);
+            return;
+        }
+        juce::Colour accent = fg.getPerceivedBrightness() < 0.2f ? juce::Colour(0xff57d465) : fg;
+        // metal rim
+        vgrad(g, d, juce::Colour(0xffe8e8e8), juce::Colour(0xff888888));
+        g.fillEllipse(d);
+        auto inner = d.reduced(w * 0.16f);
+        vgrad(g, inner, juce::Colour(0xff3a3a3a), juce::Colour(0xff181818));
+        g.fillEllipse(inner);
+        if(flash)
+        {
+            g.setColour(accent.withAlpha(0.45f));
+            g.fillEllipse(inner.expanded(1.5f));
+            g.setColour(accent);
+            g.fillEllipse(inner.reduced(1.f));
+        }
+        else
+        {
+            g.setColour(juce::Colours::white.withAlpha(0.12f));
+            g.fillEllipse(inner.reduced(1.f).withHeight(inner.getHeight() * 0.45f));
+        }
+        g.setColour(juce::Colours::black.withAlpha(0.75f));
+        g.drawEllipse(d, 1.f);
+    }
+
+    // ------------------------------------------------------------------ radios
+    inline void drawRadio(juce::Graphics& g, juce::Rectangle<float> b, int n, int sel, bool horizontal, juce::Colour bg, juce::Colour fg)
+    {
+        juce::ignoreUnused(bg);
+        auto r = b.reduced(0.5f);
+        vgrad(g, r, juce::Colour(0xff191919), juce::Colour(0xff262626));
+        g.fillRoundedRectangle(r, 2.5f);
+        juce::Colour accent = fg.getPerceivedBrightness() < 0.2f ? juce::Colour(0xffd8d8d8) : fg;
+        const float cw = horizontal ? r.getWidth() / n : r.getWidth();
+        const float ch = horizontal ? r.getHeight() : r.getHeight() / n;
+        for(int i = 1; i < n; ++i)
+        {
+            g.setColour(juce::Colours::black.withAlpha(0.6f));
+            if(horizontal) g.drawLine(r.getX() + cw * i, r.getY() + 1.f, r.getX() + cw * i, r.getBottom() - 1.f, 1.f);
+            else           g.drawLine(r.getX() + 1.f, r.getY() + ch * i, r.getRight() - 1.f, r.getY() + ch * i, 1.f);
+        }
+        juce::Rectangle<float> cell(horizontal ? r.getX() + cw * sel : r.getX(),
+                                    horizontal ? r.getY() : r.getY() + ch * sel, cw, ch);
+        cell = cell.reduced(2.f);
+        g.setColour(accent.withAlpha(0.25f));
+        g.fillRoundedRectangle(cell.expanded(1.f), 2.f);
+        vgrad(g, cell, accent.brighter(0.15f), accent.darker(0.3f));
+        g.fillRoundedRectangle(cell, 2.f);
+        g.setColour(juce::Colours::white.withAlpha(0.25f));
+        g.fillRoundedRectangle(cell.withHeight(cell.getHeight() * 0.45f).reduced(1.f, 1.f), 1.5f);
+        g.setColour(juce::Colours::black.withAlpha(0.7f));
+        g.drawRoundedRectangle(r, 2.5f, 1.f);
+    }
+
+    // ------------------------------------------------------------------ panels
+    inline void drawScrew(juce::Graphics& g, float cx, float cy, float rad)
+    {
+        juce::Rectangle<float> d(cx - rad, cy - rad, rad * 2.f, rad * 2.f);
+        g.setColour(juce::Colours::black.withAlpha(0.35f));
+        g.fillEllipse(d.expanded(1.f).translated(0.f, 0.8f));
+        vgrad(g, d, juce::Colour(0xffd0d0d0), juce::Colour(0xff707070));
+        g.fillEllipse(d);
+        g.setColour(juce::Colours::black.withAlpha(0.65f));
+        g.drawEllipse(d, 1.f);
+        g.drawLine(cx - rad * 0.55f, cy + rad * 0.3f, cx + rad * 0.55f, cy - rad * 0.3f, 1.2f);
+    }
+
+    inline void drawPanel(juce::Graphics& g, juce::Rectangle<float> b, juce::Colour bg)
+    {
+        const float w = b.getWidth(), h = b.getHeight();
+        if(w < 7.f || h < 7.f) { g.fillAll(bg); return; }              // bracket/line decorations: exact
+        if(w >= 700.f && h >= 500.f)                                    // full plate (front panel / overlay page)
+        {
+            vgrad(g, b, bg.brighter(0.045f), bg.darker(0.055f));
+            g.fillRect(b);
+            g.setGradientFill(juce::ColourGradient(juce::Colours::transparentBlack, b.getCentreX(), b.getCentreY(),
+                                                   juce::Colours::black.withAlpha(0.10f), b.getX(), b.getY(), true));
+            g.fillRect(b);
+            g.setColour(juce::Colours::black.withAlpha(0.55f));
+            g.drawRect(b, 1.f);
+            return;
+        }
+        if(h >= 7.f && h <= 30.f && w > 3.f * h)                        // label bar: subtle gloss
+        {
+            vgrad(g, b, bg.brighter(0.35f), bg.darker(0.25f));
+            g.fillRoundedRectangle(b, 2.f);
+            return;
+        }
+        g.fillAll(bg);                                                  // everything else (masks!) exact
+    }
+}
