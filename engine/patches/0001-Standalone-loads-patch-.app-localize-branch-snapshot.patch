 #include "PluginProcessor.h"
+#include <limits>
+#include <cstdlib>
 #include "PluginParameter.h"
 #include "PluginEditor.h"
 #include "PluginConfig.h"
@@ -181,13 +183,23 @@ void CamomileAudioProcessor::releaseResources()
 
 void CamomileAudioProcessor::sendParameters()
 {
+    // LIRA fork: only send parameters whose value changed since the last tick
+    // (a full resend happens whenever the cache is resized/cleared).
     auto const& parameters = AudioProcessor::getParameters();
-    for(int i = 0; i < parameters.size(); ++i)
+    const size_t n = static_cast<size_t>(parameters.size());
+    const bool full = m_params_cache.size() != n;
+    if(full) { m_params_cache.assign(n, std::numeric_limits<float>::quiet_NaN()); }
+    for(size_t i = 0; i < n; ++i)
     {
-        auto const* param = static_cast<CamomileAudioParameter const*>(parameters.getUnchecked(i));
-        m_atoms_param[0] = static_cast<float>(i+1);
-        m_atoms_param[1] = param->convertFrom0to1(param->getValue());
-        sendList("param", m_atoms_param);
+        auto const* param = static_cast<CamomileAudioParameter const*>(parameters.getUnchecked(static_cast<int>(i)));
+        const float v = param->convertFrom0to1(param->getValue());
+        if(full || v != m_params_cache[i])
+        {
+            m_params_cache[i] = v;
+            m_atoms_param[0] = static_cast<float>(i+1);
+            m_atoms_param[1] = v;
+            sendList("param", m_atoms_param);
+        }
     }
 }
 
@@ -296,6 +308,7 @@ void CamomileAudioProcessor::processInternal()
 
 void CamomileAudioProcessor::processBlock(AudioSampleBuffer& buffer, MidiBuffer& midiMessages)
 {
+    if(std::getenv("LIRA_SNAPSHOT")) { buffer.clear(); return; } // LIRA fork: no audio in snapshot mode
     ScopedNoDenormals noDenormals;
     const int blocksize = Instance::getBlockSize();
     const int nsamples  = buffer.getNumSamples();
