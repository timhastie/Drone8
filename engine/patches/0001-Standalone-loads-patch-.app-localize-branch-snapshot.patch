                         "background image " + CamomileEnvironment::getImageName() +
                         " is invalid or doesn't exist.");
     }
-    addAndMakeVisible(m_button);
-    m_button.setAlwaysOnTop(true);
+    if(std::getenv("LIRA_SNAPSHOT")) { p.suspendProcessing(true); }
