     reloadPatch();
     startTimer(25);
 }
@@ -40,6 +42,20 @@ void CamomileEditor::timerCallback()
     {
         m_patch->updateObjectsValues();
     }
+    // LIRA fork: offscreen snapshot mode for automated UI iteration
+    if(auto* snap = std::getenv("LIRA_SNAPSHOT"))
+    {
+        static int ticks = 0;
+        if(++ticks == 8)
+        {
+            auto img = createComponentSnapshot(getLocalBounds());
+            juce::File f{juce::String{snap}};
+            f.deleteFile();
+            juce::FileOutputStream os(f);
+            if(os.openedOk()) { juce::PNGImageFormat png; png.writeImageToStream(img, os); }
+            if(auto* app = juce::JUCEApplicationBase::getInstance()) { app->systemRequestedQuit(); }
+        }
+    }
 }
 
 void CamomileEditor::paint(Graphics& g)
